  "description": "Drizzle ORM integration for FilterKit — convert filter expressions to Drizzle where clauses.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turkraft/filterkit-drizzle.git"
  },
  "author": "Yusuf Torshid",
